pipeline {
    agent any
stages {
        stage('clone') {
            steps {
              git branch: 'main', credentialsId: 'd3ba5525-e643-4212-b8f4-e8e200ab6efe', url: 'https://github.com/prabhudesaipratha-byte/Javac.git'
            }
        }
    stage {
        stage('compile') {
            steps {
               bat javac'hello word'
            }
        }
            stage('Run') {
            steps {
               bat javac'hello word'
            }
        }
    }
}

